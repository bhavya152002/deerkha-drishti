# ---- Deerkha Drishti office server config ----
# Copy to .env and fill in. This file (the .example) is safe to commit; .env is NOT.
#
# NOTE: SESSION_SECRET, ADMIN_USERNAME and ADMIN_PASSWORD are now REQUIRED --
# the server refuses to start without them. They used to fall back to a
# published default ("dev-insecure-session-secret-change-me" / admin / admin),
# so a mis-provisioned host would boot happily with a forgeable admin cookie
# governing every site in the fleet.

# ---- Database -------------------------------------------------------------
# Postgres runs on this same host, so this is a loopback connection.
DATABASE_URL=postgresql://deerkha:CHANGE_ME@127.0.0.1:5432/deerkha

# Field devices do NOT use this URL. They connect over Tailscale as the
# least-privilege `deerkha_edge` role, which can only INSERT into `detections`.
# That matters: a stolen forest box previously carried a credential with full
# access to the entire database.

# ---- Admin auth (all three REQUIRED) --------------------------------------
# Generate the secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Network --------------------------------------------------------------
# Host/port Uvicorn binds to. 0.0.0.0 so the Jetson can reach it over Tailscale;
# lock the port to the Tailscale adapter in Windows Firewall.
HOST=0.0.0.0
PORT=8000

# Jetson live-frame server port (must match the edge's STREAM_SERVER_PORT).
JETSON_STREAM_PORT=8090

# ---- Persistent data ------------------------------------------------------
# Uploaded ROI reference frames. MUST live outside the code checkout, or a
# deploy will delete them while cfg_cameras.reference_frame_url still points at
# them. Under systemd this is supplied by StateDirectory=deerkha-server.
# Note: an unwritable path here means the service will not START, because the
# directory is created at import time.
DD_SERVER_DATA_DIR=/var/lib/deerkha-server

# ---- Live view tuning (field uplink is often metered 4G) -------------------
# Width/quality the dashboard grid requests from the Jetson. Tiles render at
# ~320px, so 480 covers HiDPI with no visible loss. Raising these multiplies
# uplink from every site.
LIVE_TILE_W=480
LIVE_TILE_Q=55
# Seconds a fetched snapshot is reused, so bandwidth scales with the number of
# cameras rather than the number of people watching.
LIVE_SNAPSHOT_TTL=2.0
# Max simultaneous MJPEG streams proxied. Each costs a persistent socket across
# Tailscale and a JPEG encode per frame on the Jetson, taken straight out of
# the detection pipeline's CPU budget.
LIVE_MAX_STREAMS=4

# ---- Development only -----------------------------------------------------
# Session cookies are Secure by default (the dashboard is served over the
# Cloudflare tunnel, which terminates TLS). Set to 1 ONLY to test over plain
# http:// on localhost.
# DD_INSECURE_COOKIES=1

# Optional: comma-separated list of admin emails for reference (Cloudflare Access
# does the real gating in front of the dashboard hostname).
ADMIN_EMAILS=
