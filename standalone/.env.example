# ---- Deerkha Drishti EDGE (Jetson) env ----
# Copy to `.env` next to the main script. The main script loads `.env`.
# (If your current file is named `env` with no dot, rename it to `.env`.)
# These are SECRETS / local identity -- they are NEVER server-delivered.

# --- secrets (rotate the ones that were previously committed) ---
TELEGRAM_BOT_TOKEN=xxxxxxxx:yyyyyyyyyyyyyyyyyyyyyyyy
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# TELEGRAM_CHAT_ID is used only if the server config doesn't provide one.
TELEGRAM_CHAT_ID=-1000000000

# --- device identity + office server (dynamic config) ---
# Must match the device_id you seeded on the server (python seed.py --device-id ...).
JETSON_DEVICE_ID=jetson-forest-01
# Office server over Tailscale (the office PC's tailnet IP + port).
CONFIG_SERVER_URL=http://100.x.y.z:8000
# The device token printed by `python seed.py` on the server.
CONFIG_API_TOKEN=paste-device-token-here

# Optional overrides (defaults are fine):
# CONFIG_CACHE_PATH=/home/visionlogix/dd/standalone/config_cache.json
# Live-frame stream server port (dashboard proxy connects here over Tailscale).
# Must match JETSON_STREAM_PORT on the office server. Default 8090.
# STREAM_SERVER_PORT=8090

# --- logging (all optional; defaults shown) ---
# Log level is env-only ON PURPOSE, not server-delivered: the main reason to
# raise it is "the device isn't talking to the server", and a server-delivered
# level would be unavailable in exactly that situation.
# LOG_LEVEL=INFO                                   # DEBUG|INFO|WARNING|ERROR
# LOG_DIR=/home/visionlogix/dd/standalone/logs     # default: logs/ next to the script
# LOG_MAX_BYTES=8388608                            # 8 MB per file
# LOG_BACKUPS=5                                    # -> 48 MB hard ceiling
# LOG_CONSOLE=1                                    # 0 = file only (no stderr)

# --- storage cleanup (in-process; runs inside the pipeline) ---
# Retention VALUES (days_to_keep, low_space_free_percent) come from the
# dashboard, not from here. These are operational kill-switches only.
# CLEANUP_ENABLED=1          # 0 disables the cleanup thread entirely
# CLEANUP_DRY_RUN=0          # 1 = log what WOULD be deleted, delete nothing
# CLEANUP_INTERVAL_SEC=1800  # 30 min between passes

# --- camera hot-apply ---
# CAMERA set changes (add/remove/disable/URL) apply live, no restart.
# DD_HOT_RECONCILE=0 reverts to the old static-roster behaviour (boot-time only).
# DD_HOT_RECONCILE=1
# DD_MAX_CAMERAS=8           # guard against a config asking for more than the Nano can decode
